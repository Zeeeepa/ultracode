<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Log to stderr to keep stdout clean for JSON protocol -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set default level to INFO, can be overridden via -Dlogback.configurationFile -->
    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>

    <!-- Reduce noise from Kotlin compiler internals -->
    <logger name="org.jetbrains.kotlin" level="WARN" />
</configuration>
