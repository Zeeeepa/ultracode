{
  "name": "ultrascript-tools-mcp",
  "version": "2.0.0",
  "description": "MCP server for code understanding - semantic search, duplicate detection, impact analysis for TS/JS/Python/Go/Rust/Java/C++/Kotlin",
  "license": "MIT",
  "author": "faxenoff",
  "homepage": "https://github.com/faxenoff/ultrascript-tools-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faxenoff/ultrascript-tools-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/faxenoff/ultrascript-tools-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-analysis",
    "graph",
    "rag",
    "llm",
    "agents",
    "literag",
    "typescript",
    "sqlite",
    "vector-search",
    "semantic-search",
    "claude"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ultrascript-tools-mcp": "dist/index.js",
    "ultrascript": "bin/ultrascript.js"
  },
  "files": [
    "bin/**/*.js",
    "dist/**/*.js",
    "dist/**/*.wasm",
    "dist/**/*.node",
    "dist/**/*.d.ts",
    "dist/ultrascript-tools.com",
    "src/comm/comm.c",
    "src/comm/Makefile",
    "src/comm/build.ps1",
    "src/comm/setup.ps1",
    "src/comm/README.md",
    "scripts/postinstall.js",
    "scripts/build-native-libs-macos.sh",
    "scripts/setup-embeddings.cmd",
    "scripts/setup-embeddings.sh",
    "scripts/setup-embeddings-interactive.sh",
    "scripts/setup-semantic-embedding.ps1",
    "scripts/setup-tei.ps1",
    "scripts/setup-tei.sh",
    "scripts/setup-ollama.ps1",
    "scripts/detect-gpu-architecture.ps1",
    "config/embedding-models.json",
    "config/embedding-models.schema.json",
    "README.md",
    "LICENSE",
    "prompts/**/*.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:full": "npm run build && npm run build:wasm",
    "build:native": "pwsh scripts/build-native-libs.ps1",
    "build:native:windows": "pwsh scripts/build-native-libs.ps1 -Platform windows",
    "build:native:linux": "pwsh scripts/build-native-libs.ps1 -Platform linux",
    "build:native:clean": "pwsh scripts/build-native-libs.ps1 -Clean",
    "build:cuda": "pwsh scripts/build-cuda.ps1 || (cd external-tools/native/cuda && cmake-js compile && cd ../../.. && mkdir -p dist/native/cuda && cp external-tools/native/cuda/build/Release/ultrascript_cuda.node dist/native/cuda/)",
    "build:cuda:debug": "pwsh scripts/build-cuda.ps1 -Debug",
    "build:cuda:clean": "pwsh scripts/build-cuda.ps1 -Clean",
    "build:comm": "pwsh src/comm/build.ps1",
    "build:comm:setup": "pwsh src/comm/setup.ps1",
    "build:standalone": "bun build --compile dist/index.js --outfile dist/ultrascript-mcp",
    "build:standalone:win": "bun build --compile --target=bun-windows-x64 dist/index.js --outfile dist/ultrascript-mcp.exe",
    "build:standalone:linux": "bun build --compile --target=bun-linux-x64 dist/index.js --outfile dist/ultrascript-mcp-linux",
    "build:standalone:mac": "bun build --compile --target=bun-darwin-arm64 dist/index.js --outfile dist/ultrascript-mcp-mac",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules PARSER_DISABLE_CACHE=1 node tests/run-tests.js",
    "test:quiet": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test node tests/run-tests.js --silent",
    "test:verbose": "cross-env NODE_OPTIONS=--experimental-vm-modules node tests/run-tests.js --verbose",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules node tests/run-tests.js --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules node tests/run-tests.js --coverage",
    "bench": "node benchmarks/benchmark-large-project.js && node benchmarks/benchmark-simd.js && node benchmarks/benchmark-workers.js",
    "bench:large": "node benchmarks/benchmark-large-project.js",
    "bench:simd": "node benchmarks/benchmark-simd.js",
    "bench:workers": "node benchmarks/benchmark-workers.js",
    "bun:start": "bun src/index.ts",
    "bun:dist": "bun dist/index.js",
    "bun:test": "bun test",
    "smoke": "node scripts/smoke-graph-health.js /home/er77/_work_fodler/baserow-develop",
    "smoke:clean": "node scripts/smoke-graph-health.js /home/er77/_work_fodler/baserow-develop --clean",
    "smoke:semantic": "node scripts/smoke-semantic.js /home/er77/_work_fodler/baserow-develop",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@biomejs/cli-win32-x64": "^2.3.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.53.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "cmake-js": "^7.4.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "minimatch": "^10.1.1",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^12.1.0",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.4",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@types/eslint": "^9.6.1",
    "better-sqlite3": "^12.5.0",
    "eslint": "^9.39.1",
    "lru-cache": "^11.2.2",
    "nanoid": "^5.1.6",
    "sqlite-vec": "^0.1.6",
    "vectorlite": "^0.2.0",
    "xxhash-wasm": "^1.1.0",
    "yaml": "^2.8.2",
    "zod": "^4.1.13",
    "zod-to-json-schema": "^3.25.0"
  },
  "optionalDependencies": {
    "@webgpu/node": "npm:null@^2.0.0",
    "@webgpu/types": "^0.1.66",
    "webgpu": "^0.3.8"
  },
  "overrides": {
    "boolean": "3.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "notes": {
    "boolean@3.2.0": "Deprecated transitive dependency from onnxruntime-node. Package is unmaintained but functional. Used only in optional ML features."
  }
}
