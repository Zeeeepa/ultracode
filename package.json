{
  "name": "ultrascript-tools-mcp",
  "version": "3.0.0",
  "description": "MCP server for code understanding - semantic search, duplicate detection, impact analysis for TS/JS/Python/Go/Rust/Java/C++/Kotlin",
  "license": "MIT",
  "author": "faxenoff",
  "homepage": "https://github.com/faxenoff/ultrascript-tools-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faxenoff/ultrascript-tools-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/faxenoff/ultrascript-tools-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-analysis",
    "graph",
    "rag",
    "llm",
    "agents",
    "literag",
    "typescript",
    "sqlite",
    "vector-search",
    "semantic-search",
    "claude"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ultrascript-tools-mcp": "dist/index.js",
    "ultrascript": "bin/ultrascript.js",
    "ulog": "dist/cli/log-query/log-query-cli.js"
  },
  "files": [
    "bin/**/*.js",
    "dist/**/*.js",
    "dist/**/*.wasm",
    "dist/**/*.d.ts",
    "dist/**/*.proto",
    "dist/ultrascript-tools.com",
    "external-libs/cuda-win32-x64/*.node",
    "external-libs/cuda-linux-x64/*.node",
    "src/comm/comm.c",
    "src/comm/Makefile",
    "src/comm/build.ps1",
    "src/comm/setup.ps1",
    "src/comm/README.md",
    "scripts/postinstall.js",
    "scripts/build-native-libs-macos.sh",
    "scripts/setup-embeddings.cmd",
    "scripts/setup-embeddings.sh",
    "scripts/setup-embeddings-interactive.sh",
    "scripts/setup-semantic-embedding.ps1",
    "scripts/setup-tei.ps1",
    "scripts/setup-tei.sh",
    "scripts/setup-ollama.ps1",
    "scripts/detect-gpu-architecture.ps1",
    "config/embedding-models.json",
    "config/embedding-models.schema.json",
    "config/llm-models.json",
    "README.md",
    "LICENSE",
    "prompts/**/*.md",
    "dist/parsers/python-ast-cli.py",
    "dist/parsers/go-ast-cli.go"
  ],
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');const p=require('path');const d='dist';if(fs.existsSync(d)){fs.readdirSync(d).filter(f=>f.endsWith('.js')||f.endsWith('.js.map')).forEach(f=>fs.unlinkSync(p.join(d,f)));console.log('[prebuild] Cleaned old JS chunks from dist/')}\"",
    "build": "tsup && node -e \"const fs=require('fs');const p=require('path');const d='dist/parsers';fs.mkdirSync(d,{recursive:true});fs.copyFileSync('src/parsers/python-ast-cli.py',p.join(d,'python-ast-cli.py'));fs.copyFileSync('src/parsers/go-ast-cli.go',p.join(d,'go-ast-cli.go'))\"",
    "build:watch": "tsup --watch",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:full": "npm run build && npm run build:wasm",
    "build:native": "pwsh scripts/build-native-libs.ps1",
    "build:native:windows": "pwsh scripts/build-native-libs.ps1 -Platform windows",
    "build:native:linux": "pwsh scripts/build-native-libs.ps1 -Platform linux",
    "build:native:clean": "pwsh scripts/build-native-libs.ps1 -Clean",
    "build:cuda": "pwsh scripts/build-cuda.ps1 || (cd external-tools/native/cuda && cmake-js compile && cd ../../.. && mkdir -p dist/native/cuda && cp external-tools/native/cuda/build/Release/ultrascript_cuda.node dist/native/cuda/)",
    "build:cuda:debug": "pwsh scripts/build-cuda.ps1 -Debug",
    "build:cuda:clean": "pwsh scripts/build-cuda.ps1 -Clean",
    "build:faiss": "node scripts/build-faiss-node.js",
    "build:faiss:wsl": "pwsh scripts/build-faiss-wsl.ps1",
    "build:faiss:wsl:clean": "pwsh scripts/build-faiss-wsl.ps1 -Clean",
    "build:faiss:docker": "pwsh scripts/build-faiss-docker.ps1",
    "build:faiss:docker:clean": "pwsh scripts/build-faiss-docker.ps1 -Clean",
    "build:faiss:macos": "bash scripts/build-faiss-macos.sh",
    "build:comm": "pwsh src/comm/build.ps1",
    "build:comm:setup": "pwsh src/comm/setup.ps1",
    "build:standalone": "bun build --compile dist/index.js --outfile dist/ultrascript-mcp",
    "build:standalone:win": "bun build --compile --target=bun-windows-x64 dist/index.js --outfile dist/ultrascript-mcp.exe",
    "build:standalone:linux": "bun build --compile --target=bun-linux-x64 dist/index.js --outfile dist/ultrascript-mcp-linux",
    "build:standalone:mac": "bun build --compile --target=bun-darwin-arm64 dist/index.js --outfile dist/ultrascript-mcp-mac",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --bail",
    "bench": "node benchmarks/benchmark-large-project.js && node benchmarks/benchmark-simd.js && node benchmarks/benchmark-workers.js",
    "bench:large": "node benchmarks/benchmark-large-project.js",
    "bench:simd": "node benchmarks/benchmark-simd.js",
    "bench:workers": "node benchmarks/benchmark-workers.js",
    "bun:start": "bun src/index.ts",
    "bun:dist": "bun dist/index.js",
    "smoke": "node scripts/smoke-graph-health.js /home/er77/_work_fodler/baserow-develop",
    "smoke:clean": "node scripts/smoke-graph-health.js /home/er77/_work_fodler/baserow-develop --clean",
    "smoke:semantic": "node scripts/smoke-semantic.js /home/er77/_work_fodler/baserow-develop",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@biomejs/cli-win32-x64": "^2.3.11",
    "@oxc-project/types": "^0.107.0",
    "@rollup/rollup-win32-x64-msvc": "^4.55.1",
    "@types/bun": "latest",
    "@types/glob": "^9.0.0",
    "@types/node": "^25.0.3",
    "antlr4ng": "^3.0.16",
    "antlr4ng-cli": "^2.0.0",
    "cmake-js": "^7.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@huggingface/inference": "^4.13.5",
    "@libsql/client": "^0.17.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/eslint": "^9.6.1",
    "@xenova/transformers": "^2.17.2",
    "cbor-x": "^1.6.0",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "graphology-types": "^0.24.8",
    "lru-cache": "^11.2.4",
    "nanoid": "^5.1.6",
    "oxc-parser": "^0.107.0",
    "p-limit": "^7.2.0",
    "p-map": "^7.0.4",
    "tslib": "^2.8.1",
    "xxhash-wasm": "^1.1.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "optionalDependencies": {
    "@webgpu/node": "npm:null@^2.0.0",
    "@webgpu/types": "^0.1.68",
    "faiss-napi": "^0.10.3",
    "webgpu": "^0.3.8"
  },
  "overrides": {
    "boolean": "3.2.0",
    "sharp": "npm:null@^2.0.0",
    "onnxruntime-node": "npm:null@^2.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "notes": {
    "boolean@3.2.0": "Deprecated transitive dependency. Package is unmaintained but functional.",
    "sharp-override": "sharp replaced with null - not needed for text embeddings (only tokenization used from @xenova/transformers)",
    "onnxruntime-node-override": "onnxruntime-node replaced with null - using OVMS Docker for inference instead",
    "faiss-napi": "High-performance vector indexing with NAPI bindings. Works directly under Bun (no subprocess needed). 32 prebuilt binaries for Windows/Linux/macOS (x64/ARM64). Uses HNSW/IVF indexes."
  },
  "trustedDependencies": [
    "cbor-extract",
    "esbuild",
    "faiss-napi",
    "protobufjs",
    "webgpu"
  ]
}
