{
  "name": "ultrascript-tools-mcp",
  "version": "1.2.1",
  "description": "Multi-agent LiteRAG MCP server for advanced code graph analysis",
  "license": "MIT",
  "author": "faxenoff",
  "homepage": "https://github.com/faxenoff/ultrascript-tools-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faxenoff/ultrascript-tools-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/faxenoff/ultrascript-tools-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-analysis",
    "graph",
    "rag",
    "llm",
    "agents",
    "literag",
    "typescript",
    "sqlite",
    "vector-search",
    "semantic-search",
    "claude",
    "tree-sitter"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ultrascript-tools-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.wasm",
    "dist/**/*.node",
    "dist/**/*.d.ts",
    "scripts/postinstall.js",
    "scripts/rebuild-tree-sitter.js",
    "scripts/setup-embeddings.cmd",
    "scripts/setup-embeddings.sh",
    "scripts/setup-embeddings-interactive.sh",
    "scripts/setup-semantic-embedding.ps1",
    "scripts/setup-tei.ps1",
    "scripts/setup-tei.sh",
    "scripts/setup-ollama.ps1",
    "scripts/detect-gpu-architecture.ps1",
    "config/embedding-models.json",
    "config/embedding-models.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:full": "npm run build && npm run build:wasm",
    "build:cuda": "cd external-tools/native/cuda && cmake-js compile && cd ../../..",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules PARSER_DISABLE_CACHE=1 node tests/run-tests.js",
    "test:quiet": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test node tests/run-tests.js --silent",
    "test:verbose": "cross-env NODE_OPTIONS=--experimental-vm-modules node tests/run-tests.js --verbose",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules node tests/run-tests.js --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules node tests/run-tests.js --coverage",
    "bench": "node benchmarks/benchmark-large-project.js && node benchmarks/benchmark-simd.js && node benchmarks/benchmark-workers.js",
    "bench:large": "node benchmarks/benchmark-large-project.js",
    "bench:simd": "node benchmarks/benchmark-simd.js",
    "bench:workers": "node benchmarks/benchmark-workers.js",
    "bun:start": "bun src/index.ts",
    "bun:dist": "bun dist/index.js",
    "bun:test": "bun test",
    "smoke": "node scripts/smoke-graph-health.js /home/er77/_work_fodler/baserow-develop",
    "smoke:clean": "node scripts/smoke-graph-health.js /home/er77/_work_fodler/baserow-develop --clean",
    "smoke:semantic": "node scripts/smoke-semantic.js /home/er77/_work_fodler/baserow-develop",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@biomejs/cli-win32-x64": "^2.3.6",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.53.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "cmake-js": "^7.4.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.6",
    "minimatch": "^10.1.1",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^12.1.0",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.3",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@types/eslint": "^9.6.1",
    "better-sqlite3": "^12.4.1",
    "eslint": "^9.39.1",
    "lru-cache": "^11.2.2",
    "nanoid": "^5.1.6",
    "sqlite-vec": "^0.1.6",
    "tree-sitter": "^0.25.0",
    "tree-sitter-bash": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.0",
    "tree-sitter-powershell": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-swift": "^0.6.0",
    "vectorlite": "^0.2.0",
    "xxhash-wasm": "^1.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12",
    "zod-to-json-schema": "^3.25.0"
  },
  "optionalDependencies": {
    "@webgpu/node": "npm:null@^2.0.0",
    "@webgpu/types": "^0.1.66",
    "webgpu": "^0.3.8"
  },
  "overrides": {
    "boolean": "3.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "notes": {
    "boolean@3.2.0": "Deprecated transitive dependency from onnxruntime-node. Package is unmaintained but functional. Used only in optional ML features."
  }
}
