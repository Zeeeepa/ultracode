{
  "$schema": "./llm-models.schema.json",
  "version": "1.1.0",
  "description": "LLM models for code documentation generation (AutoDoc feature). Updated Dec 2025.",
  "scenarios": {
    "production": {
      "name": "Production (best quality)",
      "description": "Best quality docstring generation. Qwen2.5-Coder-7B specialized for code.",
      "tgi": "tgi-qwen2.5-coder-7b",
      "openvino": "qwen2.5-coder-7b-int4",
      "ollama": "qwen2.5-coder:7b"
    },
    "fast": {
      "name": "Fast (balanced)",
      "description": "Good balance of speed and quality. Phi-4-mini is fast and code-aware.",
      "tgi": "tgi-phi-4-mini",
      "openvino": "phi-4-mini-int4",
      "ollama": "phi4-mini"
    },
    "minimal": {
      "name": "Minimal (low resources)",
      "description": "For systems with <4GB RAM. Qwen2.5-0.5B via GGUF is tiny but capable.",
      "tgi": null,
      "openvino": "qwen2.5-0.5b-gguf",
      "ollama": "qwen2.5:0.5b"
    },
    "npu": {
      "name": "NPU (Intel Core Ultra)",
      "description": "Optimized for Intel Core Ultra NPU. Arrow Lake: ~2.9 tok/s (limited compat), Lunar Lake: 20-25 tok/s.",
      "status": "WORKING",
      "driver_required": "32.0.100.4181+",
      "driver_tested": "32.0.100.4404",
      "arrow_lake_note": "⚠️ Arrow Lake NPU (275HX) has different vpux-compiler. Only OpenVINO/Qwen3-4B works (~2.9 tok/s). CPU is faster (25+ tok/s)!",
      "lunar_lake_note": "✅ Lunar Lake NPU (258V) supports more models: Qwen3-4B (20-25 tok/s), Phi-4-mini (25-30 tok/s).",
      "tgi": null,
      "openvino": "qwen3-4b-npu-int4",
      "ollama": null
    }
  },
  "providers": {
    "tgi": {
      "name": "TGI (Text Generation Inference)",
      "description": "HuggingFace официальный LLM сервер\n⚡ Native batch + continuous batching\n🚀 GPU: RTX 30xx/40xx (Ampere/Ada)\n❌ RTX 50xx (Blackwell) - НЕ поддерживается, ждать HuggingFace\n🐳 Требуется Docker Desktop\n📊 Prometheus metrics встроены",
      "requires": ["docker", "nvidia-gpu-pre-blackwell"],
      "optional": [],
      "default_port": 8080,
      "container_name": "tgi-server",
      "supports_batch": true,
      "image_gpu": "ghcr.io/huggingface/text-generation-inference:3.3.4",
      "image_cpu": "ghcr.io/huggingface/text-generation-inference:3.3.4-intel-cpu",
      "blackwell_status": "NOT_SUPPORTED",
      "blackwell_notes": "RTX 50xx (Blackwell) не поддерживается. Альтернативы: Ollama (работает), OpenVINO CPU, или ждать патч от HuggingFace"
    },
    "openvino": {
      "name": "OpenVINO GenAI 2025.4",
      "description": "Intel OpenVINO LLM inference\n- CPU/GPU/NPU support\n- INT4/INT8 quantization\n- GGUF direct loading\n- MoE models (Qwen3-30B-A3B)\n- Structured output (XGrammar)\n- Tool calling + parsers\n- Prefix caching\n- NPU context up to 10K",
      "requires": ["openvino-genai"],
      "optional": ["intel-npu"],
      "default_device": "CPU",
      "version": "2025.4"
    },
    "ollama": {
      "name": "Ollama",
      "description": "Local LLM inference\n- Easy installation\n- All GPU vendors (включая RTX 50xx)\n- Streaming\n- Нет Docker",
      "requires": ["ollama"],
      "optional": ["nvidia-gpu"],
      "default_port": 11434
    }
  },
