{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ultracode.dev/schemas/embedding-models.json",
  "title": "Embedding Models Configuration",
  "description": "Configuration file for embedding model providers and available models",
  "type": "object",
  "required": ["version", "providers", "models", "default_models"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration schema version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "providers": {
      "type": "object",
      "description": "Available embedding providers",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "description", "requires"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the provider"
          },
          "description": {
            "type": "string",
            "description": "Detailed description with features (supports \\n for newlines)"
          },
          "requires": {
            "type": "array",
            "description": "Required dependencies",
            "items": {
              "type": "string",
              "enum": ["docker", "ollama"]
            }
          },
          "optional": {
            "type": "array",
            "description": "Optional dependencies for enhanced features",
            "items": {
              "type": "string",
              "enum": ["nvidia-gpu"]
            }
          },
          "default_port": {
            "type": "integer",
            "description": "Default port for the provider service",
            "minimum": 1,
            "maximum": 65535
          },
          "container_name": {
            "type": "string",
            "description": "Docker container name (for Docker-based providers)"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "description": "Available embedding models",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "name",
          "model_id",
          "gpu_support",
          "language",
          "context_tokens",
          "dimensions",
          "size_mb",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the model"
          },
          "provider": {
            "type": "string",
            "description": "Provider this model belongs to",
            "enum": ["tei", "ollama", "memory"]
          },
          "name": {
            "type": "string",
            "description": "Display name of the model"
          },
          "badge": {
            "type": ["string", "null"],
            "description": "Optional badge/label for the model (e.g., '⭐ Recommended')"
          },
          "model_id": {
            "type": "string",
            "description": "Model identifier (HuggingFace model ID or Ollama model name)"
          },
          "gpu_support": {
            "type": "boolean",
            "description": "Whether this model supports GPU acceleration"
          },
          "image_gpu": {
            "type": ["string", "null"],
            "description": "Docker image for GPU mode (TEI only)"
          },
          "image_cpu": {
            "type": ["string", "null"],
            "description": "Docker image for CPU mode (TEI only)"
          },
          "gpu_tag": {
            "type": ["string", "null"],
            "description": "Docker image tag for GPU version"
          },
          "cpu_tag": {
            "type": ["string", "null"],
            "description": "Docker image tag for CPU version"
          },
          "language": {
            "type": "string",
            "description": "Supported language(s)",
            "enum": ["en", "multi", "ru", "zh"]
          },
          "context_tokens": {
            "type": "integer",
            "description": "Maximum context window in tokens",
            "minimum": 128
          },
          "dimensions": {
            "type": "integer",
            "description": "Embedding vector dimensions",
            "minimum": 128
          },
          "size_mb": {
            "type": "number",
            "description": "Approximate model size in megabytes",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of model characteristics"
          },
          "notes": {
            "type": "string",
            "description": "Optional additional notes or warnings"
          }
        }
      }
    },
    "default_models": {
      "type": "object",
      "description": "Default model selection for each provider",
      "required": ["tei", "ollama", "memory"],
      "properties": {
        "tei": {
          "type": "string",
          "description": "Default TEI model ID"
        },
        "ollama": {
          "type": "string",
          "description": "Default Ollama model ID"
        },
        "memory": {
          "type": "null",
          "description": "Memory provider has no models"
        }
      }
    }
  }
}
