{
  "$schema": "./embedding-models.schema.json",
  "version": "1.6.0",
  "scenarios": {
    "production": {
      "name": "Production (максимальное качество)",
      "description": "Для production использования. jina-code-v2 — лучшая для code search (30 языков программирования).",
      "tei": "jina-code-v2",
      "ollama": "ollama-snowflake-arctic"
    },
    "development": {
      "name": "Разработка (быстрая индексация)",
      "description": "Для локальной разработки. BGE-small — 62.17 MTEB при скорости MiniLM (upgrade path).",
      "tei": "bge-small-en",
      "ollama": "ollama-all-minilm"
    },
    "large_projects": {
      "name": "Большие проекты (баланс)",
      "description": "Для крупных кодовых баз. GTE-large 65.39 MTEB + 8K контекст.",
      "tei": "gte-large-en-v1.5",
      "ollama": "ollama-snowflake-arctic"
    },
    "legacy_code": {
      "name": "Legacy код (длинные методы)",
      "description": "Для legacy проектов с длинными методами (100+ строк). 8K контекст обязателен.",
      "tei": "nomic-embed-v1.5",
      "ollama": "ollama-snowflake-arctic"
    },
    "multilingual": {
      "name": "Мультиязычный код",
      "description": "Для проектов с RU/CN/JP комментариями. BGE-M3 — 100+ языков + hybrid search.",
      "tei": "bge-m3",
      "ollama": "ollama-snowflake-arctic"
    }
  },
  "providers": {
    "tei": {
      "name": "TEI (Text Embeddings Inference)",
      "description": "HuggingFace официальный inference сервер\n⚡ Native batch - в 10-30x быстрее Ollama\n🚀 GPU: RTX 30xx/40xx (Ampere/Ada)\n⚠️ RTX 50xx (Blackwell) - только CPU режим\n🐳 Требуется Docker Desktop",
      "requires": ["docker"],
      "optional": ["nvidia-gpu"],
      "default_port": 8080,
      "container_name": "tei-server",
      "supports_batch": true,
      "gpu_notes": "RTX 50xx (Blackwell) не поддерживается GPU режим - используйте CPU или Ollama"
    },
    "ollama": {
      "name": "Ollama",
      "description": "Простая локальная установка без Docker\n✅ Легкая установка\n🎮 Все GPU включая RTX 50xx (Blackwell)\n⚠️ Нет native batch\n📦 Подходит для разработки",
      "requires": ["ollama"],
      "optional": ["nvidia-gpu"],
      "default_port": 11434,
      "supports_batch": false
    },
    "memory": {
      "name": "Memory Provider (без ML)",
      "description": "Hash-based embeddings (без ML)\n⚠️ Только детерминированный хеш\n✅ Установка не требуется\n⚡ Мгновенно, без вычислений",
      "requires": [],
      "optional": [],
      "supports_batch": true
    },
    "openvino": {
      "name": "OpenVINO (локальный CPU/GPU)",
      "description": "Intel OpenVINO inference\n⚡ CPU INT8: ~1.3ms/запрос - быстрее всех!\n🖥️ Intel GPU поддержка\n⚠️ Intel NPU пока не поддерживает BERT\n✅ Автозагрузка моделей",
      "requires": [],
      "optional": ["intel-gpu"],
      "supports_batch": true,
      "default_device": "CPU",
      "performance_notes": "CPU INT8 в 3-10x быстрее Ollama/TEI"
    }
  },
