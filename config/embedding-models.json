      "gpu_architectures": ["turing", "ampere-80", "ampere-86", "ada", "hopper", "blackwell-patch"],
      "gpu_support": true,
      "image_gpu": "ghcr.io/huggingface/text-embeddings-inference:1.8.3",
      "image_cpu": "ghcr.io/huggingface/text-embeddings-inference:cpu-1.8.3",
