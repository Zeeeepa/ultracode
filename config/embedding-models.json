{
  "$schema": "./embedding-models.schema.json",
  "version": "1.4.0",
  "scenarios": {
    "production": {
      "name": "Production (максимальное качество)",
      "description": "Для production использования. 8K контекст захватывает полный код методов и классов без потерь.",
      "tei": "jina-code-v2",
      "ollama": "ollama-nomic-embed"
    },
    "development": {
      "name": "Разработка (быстрая индексация)",
      "description": "Для локальной разработки. Быстрая индексация, достаточно для коротких методов (<50 строк).",
      "tei": "all-minilm-l6-v2",
      "ollama": "ollama-all-minilm"
    },
    "large_projects": {
      "name": "Большие проекты (баланс)",
      "description": "Для крупных кодовых баз. 8K контекст + оптимизированная скорость.",
      "tei": "gte-modernbert",
      "ollama": "ollama-snowflake-arctic"
    },
    "legacy_code": {
      "name": "Legacy код (длинные методы)",
      "description": "Для legacy проектов с длинными методами (100+ строк). Обязательно 8K контекст.",
      "tei": "jina-code-v2",
      "ollama": "ollama-nomic-embed"
    },
    "multilingual": {
      "name": "Мультиязычный код",
      "description": "Для проектов с комментариями/документацией на разных языках.",
      "tei": "paraphrase-multilingual-minilm",
      "ollama": "ollama-granite-multilingual"
    }
  },
  "providers": {
    "tei": {
      "name": "TEI (Text Embeddings Inference)",
      "description": "HuggingFace официальный inference сервер\n⚡ Native batch - в 10-30x быстрее Ollama\n🚀 GPU: RTX 30xx/40xx (Ampere/Ada)\n⚠️ RTX 50xx (Blackwell) - только CPU режим\n🐳 Требуется Docker Desktop",
      "requires": ["docker"],
      "optional": ["nvidia-gpu"],
      "default_port": 8080,
      "container_name": "tei-server",
      "supports_batch": true,
      "gpu_notes": "RTX 50xx (Blackwell) не поддерживается GPU режим - используйте CPU или Ollama"
    },
    "ollama": {
      "name": "Ollama",
      "description": "Простая локальная установка без Docker\n✅ Легкая установка\n🎮 Все GPU включая RTX 50xx (Blackwell)\n⚠️ Нет native batch\n📦 Подходит для разработки",
      "requires": ["ollama"],
      "optional": ["nvidia-gpu"],
      "default_port": 11434,
      "supports_batch": false
    },
    "memory": {
      "name": "Memory Provider (без ML)",
      "description": "Hash-based embeddings (без ML)\n⚠️ Только детерминированный хеш\n✅ Установка не требуется\n⚡ Мгновенно, без вычислений",
      "requires": [],
      "optional": [],
      "supports_batch": true
    }
  },
