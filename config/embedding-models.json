{
  "$schema": "./embedding-models.schema.json",
  "version": "1.0.0",
  "providers": {
    "tei": {
      "name": "TEI (Text Embeddings Inference)",
      "description": "HuggingFace official inference server\n✅ High context (up to 8192 tokens)\n🚀 Auto GPU detection (RTX 30xx/40xx)\n🐳 Requires Docker Desktop\n⚡ 5-10x faster on GPU",
      "requires": ["docker"],
      "optional": ["nvidia-gpu"],
      "default_port": 8080,
      "container_name": "tei-server"
    },
    "ollama": {
      "name": "Ollama",
      "description": "Simple local inference without Docker\n✅ Easy installation\n🎮 Auto-detects GPU\n⚠️  Context depends on model (512-8192 tokens)\n📦 Smaller download size",
      "requires": ["ollama"],
      "optional": ["nvidia-gpu"],
      "default_port": 11434
    },
    "memory": {
      "name": "Memory Provider (No ML)",
      "description": "Hash-based embeddings (no ML inference)\n⚠️  Deterministic hashing only\n✅ No installation needed\n⚡ Instant, no compute",
      "requires": [],
      "optional": []
    }
  },
