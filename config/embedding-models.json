{
  "$schema": "./embedding-models.schema.json",
  "version": "2.1.0",
  "scenarios": {
    "development": {
      "name": "Разработка (быстрая индексация)",
      "description": "Для локальной разработки. TEI E5-Small — 1,786 texts/s (GPU), OpenVINO — 583 chunks/s (CPU). 94 языка.",
      "ovms": "ovms-multilingual-e5-base",
      "ollama": "ollama-qwen3-embed-sm",
      "tei": "tei-multilingual-e5-small",
      "vllm": "vllm-multilingual-e5-small"
    },
    "production": {
      "name": "Production (качество + скорость)",
      "description": "Для production. OpenVINO E5-Base — лучший баланс качества и скорости, 94 языка.",
      "ovms": "ovms-multilingual-e5-base",
      "ollama": "ollama-mxbai-embed-large",
      "tei": "tei-multilingual-e5-base",
      "vllm": "vllm-multilingual-e5-large"
    },
    "large_context": {
      "name": "Длинный контекст (8K)",
      "description": "Для legacy проектов с методами 500+ строк. BGE-M3 — 8K контекст, 100+ языков.",
      "tei": "bge-m3",
      "ovms": "ovms-bge-m3",
      "ollama": "ollama-bge-m3",
      "vllm": "vllm-bge-m3"
    },
    "multilingual": {
      "name": "Мультиязычный код",
      "description": "Для проектов с RU/CN/JP комментариями. Nomic v2 MoE — 8K контекст, мультиязычный.",
      "ovms": "ovms-multilingual-e5-base",
      "tei": "tei-paraphrase-multilingual",
      "ollama": "ollama-nomic-embed-v2",
      "vllm": "vllm-multilingual-e5-large"
    },
    "frontier": {
      "name": "Максимальное качество (4096 dims)",
      "description": "Для критичных проектов. Qwen3 8B / E5-Mistral 7B — frontier качество, требует 16GB VRAM.",
      "ollama": "ollama-qwen3-embed-lg",
      "tei": "tei-multilingual-e5-base",
      "ovms": "ovms-multilingual-e5-base",
      "vllm": "vllm-e5-mistral-7b"
    },
    "gpu_optimized": {
      "name": "GPU-ускоренный (vLLM)",
      "description": "Для NVIDIA GPU. vLLM с OpenAI-совместимым API. Быстрый batching.",
      "vllm": "vllm-multilingual-e5-large",
      "tei": "tei-multilingual-e5-base",
      "ollama": "ollama-mxbai-embed-large"
    }
  },
  "providers": {
    "ovms": {
      "name": "OpenVINO (CPU/NPU)",
      "description": "Intel OpenVINO inference на CPU/NPU\n🏆 Fastest: 510 chunks/s (all-MiniLM)\n⚡ 2ms/chunk латентность\n✅ Не требует GPU\n✅ V3 /v3/embeddings API с MEAN pooling",
      "requires": ["docker"],
      "optional": ["intel-npu"],
      "supports_batch": true,
      "default_device": "CPU",
      "capabilities": {
        "embeddings": true,
        "rerank": false,
        "score": false,
        "classify": false,
        "endpoints": {
          "embeddings": "/v3/embeddings"
        }
      }
    },
    "tei": {
      "name": "TEI (GPU Docker)",
      "description": "HuggingFace Text Embeddings Inference\n🚀 1,786 texts/s (E5-small batch 50)\n⚡ 28ms avg латентность\n📄 До 8K контекст\n🐳 Требует Docker\n⚠️ RTX 50xx: используй hotchpotch/tei-blackwell-testing",
      "requires": ["docker"],
      "optional": ["nvidia-gpu"],
      "default_port": 8081,
      "container_name": "tei-server",
      "supports_batch": true,
      "capabilities": {
        "embeddings": true,
        "rerank": true,
        "score": false,
        "classify": false,
        "endpoints": {
          "embeddings": "/embed",
          "rerank": "/rerank"
        }
      }
    },
    "ollama": {
      "name": "Ollama (GPU/CPU)",
      "description": "Простая локальная установка\n✅ Все GPU включая RTX 50xx\n🥇 all-minilm: лучшее качество (gap 0.601)\n⚠️ Медленнее OpenVINO/TEI",
      "requires": ["ollama"],
      "optional": ["nvidia-gpu"],
      "default_port": 11434,
      "supports_batch": false,
      "capabilities": {
        "embeddings": true,
        "rerank": false,
        "score": false,
        "classify": false,
        "endpoints": {
          "embeddings": "/api/embeddings"
        }
      }
    },
    "vllm": {
      "name": "vLLM (NVIDIA GPU Docker)",
      "description": "GPU-ускоренный inference server от vLLM Project\n🚀 OpenAI-совместимый API (/v1/embeddings)\n⚡ Быстрый batching для embedding моделей\n🐳 Требует Docker + NVIDIA Container Toolkit\n✅ RTX 30xx/40xx/50xx, A100, H100",
      "requires": ["docker", "nvidia-gpu", "nvidia-container-toolkit"],
      "optional": [],
      "default_port": 8000,
      "container_name": "vllm-embeddings",
      "supports_batch": true,
      "api_format": "openai",
      "image": "vllm/vllm-openai:latest",
      "capabilities": {
        "embeddings": true,
        "rerank": true,
        "score": true,
        "classify": true,
        "endpoints": {
          "embeddings": "/v1/embeddings",
          "rerank": "/v1/rerank",
          "score": "/v1/score",
          "classify": "/classify"
        }
      }
    }
  },
