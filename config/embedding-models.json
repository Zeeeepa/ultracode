{
  "$schema": "./embedding-models.schema.json",
  "version": "2.1.0",
  "scenarios": {
    "development": {
      "name": "Разработка (быстрая индексация)",
      "description": "Для локальной разработки. TEI E5-Small — 1,169 emb/s (GPU), vLLM — 1,352 emb/s (GPU), OpenVINO — 583 chunks/s (CPU). 94 языка.",
      "ovms": "ovms-multilingual-e5-base",
      "tei": "tei-multilingual-e5-small",
      "vllm": "vllm-multilingual-e5-small"
    },
    "production": {
      "name": "Production (качество + скорость)",
      "description": "Для production. OpenVINO E5-Base — лучший баланс качества и скорости, 94 языка.",
      "ovms": "ovms-multilingual-e5-base",
      "tei": "tei-multilingual-e5-base",
      "vllm": "vllm-multilingual-e5-large"
    },
    "large_context": {
      "name": "Длинный контекст (8K)",
      "description": "Для legacy проектов с методами 500+ строк. BGE-M3 — 8K контекст, 100+ языков.",
      "tei": "bge-m3",
      "ovms": "ovms-bge-m3",
      "vllm": "vllm-bge-m3"
    },
    "multilingual": {
      "name": "Мультиязычный код",
      "description": "Для проектов с RU/CN/JP комментариями. Nomic v2 MoE — 8K контекст, мультиязычный.",
      "ovms": "ovms-multilingual-e5-base",
      "tei": "tei-paraphrase-multilingual",
      "vllm": "vllm-multilingual-e5-large"
    },
    "frontier": {
      "name": "Максимальное качество (4096 dims)",
      "description": "Для критичных проектов. E5-Mistral 7B — frontier качество, требует 16GB VRAM.",
      "tei": "tei-multilingual-e5-base",
      "ovms": "ovms-multilingual-e5-base",
      "vllm": "vllm-e5-mistral-7b"
    },
    "gpu_optimized": {
      "name": "GPU-ускоренный (vLLM)",
      "description": "Для NVIDIA GPU. vLLM с OpenAI-совместимым API. Быстрый batching.",
      "vllm": "vllm-multilingual-e5-large",
      "tei": "tei-multilingual-e5-base"
    }
  },
  "providers": {
    "ovms": {
      "name": "OpenVINO (CPU/NPU)",
      "description": "Intel OpenVINO inference на CPU/NPU\n🏆 Fastest: 510 chunks/s (all-MiniLM)\n⚡ 2ms/chunk латентность\n✅ Не требует GPU\n✅ V3 /v3/embeddings API с MEAN pooling",
      "requires": ["docker"],
      "optional": ["intel-npu"],
      "supports_batch": true,
      "default_device": "CPU",
      "capabilities": {
        "embeddings": true,
        "rerank": false,
        "score": false,
        "classify": false,
        "endpoints": {
          "embeddings": "/v3/embeddings"
        }
      }
    },
    "tei": {
      "name": "TEI (GPU Docker)",
      "description": "HuggingFace Text Embeddings Inference\n🚀 1,169 emb/s (E5-small, Accumulator, RTX 5090)\n⚡ Peak 2,442 emb/s\n📄 До 8K контекст\n🐳 Требует Docker\n✅ RTX 50xx: image 120-latest (TEI 1.9.1+)",
      "requires": ["docker"],
      "optional": ["nvidia-gpu"],
      "default_port": 8081,
      "container_name": "tei-server",
      "supports_batch": true,
      "capabilities": {
        "embeddings": true,
        "rerank": true,
        "score": false,
        "classify": false,
        "endpoints": {
          "embeddings": "/embed",
          "rerank": "/rerank"
        }
      }
    },
    "vllm": {
      "name": "vLLM (NVIDIA GPU Docker)",
      "description": "GPU-ускоренный inference server от vLLM Project\n🚀 OpenAI-совместимый API (/v1/embeddings)\n⚡ Быстрый batching для embedding моделей\n🐳 Требует Docker + NVIDIA Container Toolkit\n✅ RTX 30xx/40xx/50xx, A100, H100",
      "requires": ["docker", "nvidia-gpu", "nvidia-container-toolkit"],
      "optional": [],
      "default_port": 8000,
      "container_name": "vllm-embeddings",
      "supports_batch": true,
      "api_format": "openai",
      "image": "vllm/vllm-openai:latest",
      "capabilities": {
        "embeddings": true,
        "rerank": true,
        "score": true,
        "classify": true,
        "endpoints": {
          "embeddings": "/v1/embeddings",
          "rerank": "/v1/rerank",
          "score": "/v1/score",
          "classify": "/classify"
        }
      }
    },
    "llamacpp": {
      "name": "llama.cpp (Native GGUF)",
      "description": "Нативный сервер llama.cpp с GGUF моделями\n✅ Без Docker\n🎮 CUDA/Vulkan/CPU\n📦 Компактные квантизованные модели\n⚡ OpenAI-совместимый API (/v1/embeddings)\n🔧 AMD/Intel/NVIDIA GPU через Vulkan\n⚡ Flash Attention + Parallel Slots",
      "requires": [],
      "optional": ["nvidia-gpu", "amd-gpu", "vulkan"],
      "default_port": 8085,
      "supports_batch": true,
      "api_format": "openai",
      "optimizations": {
        "flash_attn": true,
        "parallel_slots": 4,
        "ctx_size": 2048,
        "batch_size": 1024,
        "ubatch_size": 512,
        "mlock": true,
        "threads": "auto_pcores",
        "continuous_batching": true,
        "_note": "ctx_size divided by parallel_slots = tokens per request (2048/4=512)"
      },
      "tuning_guide": {
        "threads": {
          "description": "Число потоков CPU. ВАЖНО: используйте P-cores (физические), НЕ все логические!",
          "recommendation": "Intel 12th+: P-cores только (8-core i9 = -t 8, НЕ -t 24)",
          "auto_detection": "Автоматически определяется через WMIC/sysctl/procfs"
        },
        "gpu_layers": {
          "description": "Число слоёв на GPU. -1 = все, 0 = только CPU",
          "recommendation": "Начинайте с -ngl 20-30, увеличивайте пока хватает VRAM"
        },
        "batch_size": {
          "description": "Размер batch для prompt processing (--batch-size)",
          "recommendation": "2048-4096 для embedding. Больше = лучше GPU utilization"
        },
        "ubatch_size": {
          "description": "Micro-batch размер (--ubatch-size). Влияет на throughput",
          "recommendation": "1024-2048. Увеличение на 25%+ может дать ~25% speedup"
        },
        "continuous_batching": {
          "description": "Позволяет обрабатывать несколько запросов параллельно",
          "recommendation": "НЕ используйте --no-cont-batching! Это критично для throughput"
        },
        "parallel_slots": {
          "description": "Количество параллельных слотов для concurrent requests",
          "recommendation": "4-8 для embedding workloads. Используйте с --parallel 4"
        },
        "ctx_size_parallel": {
          "description": "ВАЖНО: ctx-size ДЕЛИТСЯ на parallel! Каждый slot = ctx_size/parallel токенов",
          "recommendation": "Для 512 токенов на запрос с --parallel 4, нужен --ctx-size 2048"
        },
        "expected_performance": {
          "vs_vllm": "50-67% от vLLM (400-800/s vs 1200/s) при правильной настройке",
          "bottlenecks": "GGUF dequantization, single-threaded prompt processing"
        }
      },
      "capabilities": {
        "embeddings": true,
        "rerank": false,
        "score": false,
        "classify": false,
        "endpoints": {
          "embeddings": "/v1/embeddings"
        }
      }
    }
  },
