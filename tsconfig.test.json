{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "strict": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    // Enable Jest types for test files
    "types": ["jest", "node"]
  },
  "include": ["src/**/__tests__/**/*.ts", "src/**/*.test.ts", "src/**/*.spec.ts", "tests/**/*.ts"]
}
