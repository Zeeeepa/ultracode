{
  "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**",
      "tests/**",
      "config/**",
      "Dev.Scripts/**/*.md",
      "*.ts",
      "*.js",
      "*.json",
      "*.md",
      "!!**/package-lock.json",
      "!!**/bun.lock",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/build",
      "!!**/.git"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "noDuplicateCase": "warn",
        "noAssignInExpressions": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noStaticOnlyClass": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      }
    }
  }
}
