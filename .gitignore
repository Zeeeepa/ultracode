# External libs — keep pre-built native .node modules in git
# Only ignore FAISS GPU (too large) and tar.gz archives
/external-libs/faiss-gpu-*/
/external-libs/*.tar.gz

# External tools & dependencies (downloaded during setup)
/external-tools/emsdk/
/external-tools/nodejs/
/external-tools/python/
# But keep source code
!/external-tools/README.md
!/external-tools/wasm/
!/external-tools/native/
# Ignore build artifacts and dependencies in external-tools
external-tools/**/target/
external-tools/**/pkg/
external-tools/**/build/
external-tools/**/node_modules/
# Build intermediates in external-tools (final .node goes to external-libs/)
external-tools/**/*.node
external-tools/**/*.exp
external-tools/**/*.lib
/tools/
/emsdk/

# Test snapshots & temp files
src/merge/**/*.test.ts.snap
src/merge/**/temp/

